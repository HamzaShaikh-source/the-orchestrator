{
  "name": "the-orchestrator",
  "version": "3.1.1",
  "description": "Multi-agent AI orchestration engine — self-contained Chrome extension, plus a Node harness backed by a vendored Web2API server",
  "type": "module",
  "main": "harness/index.js",
  "bin": {
    "orchestrator": "harness/index.js"
  },
  "scripts": {
      "start": "node harness/index.js",
      "serve": "node harness/server.js",
      "dev": "node scripts/services.mjs",
      "web2api": "node scripts/web2api.mjs",
      "setup": "node scripts/setup.mjs",
      "ext": "node scripts/ext.mjs",
      "cookies": "python scripts/capture_cookies.py --list",
      "test": "node --test"
    },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}