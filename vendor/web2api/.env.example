# Copy to .env and fill in values as needed.
# See README.md and docs/COOKIES.md for setup instructions.

# Directory containing auth JSON files (default: ./auth)
# WEB2API_AUTH_DIR=./auth

# Perplexity cookies as a JSON object string
# PERPLEXITY_COOKIES='{"__Secure-next-auth.session-token":"..."}'

# ChatGPT auth as a JSON object string
# CHATGPT_AUTH='{"cookies":{},"headers":{},"account_id":"..."}'

# Gemini auth as a JSON object string
# GEMINI_AUTH='{"cookies":{"__Secure-1PSID":"..."}}'

# Require Bearer token on /api/* routes (strongly recommended in production)
# WEB2API_API_KEY=your-secret-key
